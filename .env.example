PORT=8080
BASE_PATH=/
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ADMIN_JWT_SECRET=replace-with-a-strong-random-secret

# Automatic backups
BACKUP_SCHEDULE_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_FORMAT=json
BACKUP_KEEP_LOCAL_COUNT=30
BACKUP_START_DELAY_SECONDS=90

# Optional outside storage: DigitalOcean Spaces
# Create a private Space, then add these values in DigitalOcean App Platform.
BACKUP_SPACES_REGION=nyc3
BACKUP_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
BACKUP_SPACES_BUCKET=your-private-backup-space
BACKUP_SPACES_ACCESS_KEY_ID=replace-with-spaces-key
BACKUP_SPACES_SECRET_ACCESS_KEY=replace-with-spaces-secret
BACKUP_SPACES_PREFIX=rajesh-shopping-center/backups
