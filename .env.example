# Copy to .env and fill in. .env is git-ignored (.gitignore:53-55); .env.example is not,
# so never put a real value in this file.
#
# Values marked "SECRET in DigitalOcean" cannot be read back from the DO dashboard.
# See docs/DIGITALOCEAN-exit-checklist.md for how to recover them before deleting.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
BASE_PATH=/
NODE_ENV=development
# error | warn | info | debug
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
# SECRET in DigitalOcean.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Caps concurrent connections. Leave unset on a normal server. Set to 1 on
# serverless (Vercel), where every function instance opens its own pool — and
# point DATABASE_URL at Supabase's transaction pooler (port 6543), not the
# direct connection (5432).
# DATABASE_POOL_MAX=1
#
# Only for a host serving a self-signed certificate, as DigitalOcean did.
# Supabase presents a trusted certificate, so leave this unset there —
# switching verification off silently is how a connection ends up interceptable.
# DATABASE_SSL_NO_VERIFY=true

# ── Admin login ──────────────────────────────────────────────────────────────
# SECRET in DigitalOcean. If unset, the server generates a random one at boot and
# every restart logs the owner out — set it in production.
ADMIN_JWT_SECRET=replace-with-a-strong-random-secret
# Initial password, used only until the owner sets their own. Defaults to
# "admin123" if unset, so set it before the site is reachable.
ADMIN_PASSWORD=replace-before-going-live

# ── Telegram: login codes and password recovery ──────────────────────────────
# Both SECRET in DigitalOcean. Without these the owner cannot receive a login
# code or reset a forgotten password — see HANDOVER.md section 4.
#
# The token is recoverable from @BotFather (/mybots -> the bot -> API Token) if
# it is ever lost.
#
# NOTE: the code also accepts misspelled aliases that exist in the live
# environment — TELEGRAM_BOT_TOI, TELEGRAM_BOT, TELEGRAM_TOKEN for the token, and
# TELEGRAM_CHAT_IDS, TELEGRAM_CHAT_II, TELEGRAM_CHAT, TELEGRAM_OWNER_CHAT_ID for
# the chat id (utils/telegram-service.ts:15-28). When copying values out of
# DigitalOcean, check the misspelled names too — the real value may be under one
# of those. New environments should use only the two canonical names below.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_CHAT_ID=replace-with-chat-id

# ── Scheduled work on serverless ─────────────────────────────────────────────
# Required on Vercel. The daily cron at /api/cron/daily replaces the two
# background workers a long-running server runs at boot, and refuses to do
# anything unless this matches the Authorization header Vercel sends.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-strong-random-secret

# ── Automatic backups ────────────────────────────────────────────────────────
# Where backups are written before upload. Defaults to ./backups on a normal
# server and to the OS temp dir on Vercel, whose filesystem is read-only. On
# serverless nothing here survives the request, so BACKUP_SPACES_* below stops
# being optional — the uploaded copy is the only copy.
# BACKUP_DIR=/tmp/backups
BACKUP_SCHEDULE_ENABLED=true
BACKUP_INTERVAL_HOURS=24
# json | sql
BACKUP_FORMAT=json
BACKUP_KEEP_LOCAL_COUNT=30
BACKUP_START_DELAY_SECONDS=90

# ── Off-server backup storage (S3-compatible) ────────────────────────────────
# Without these, backups exist only inside the container and are lost on every
# redeploy. Works with DigitalOcean Spaces, Cloudflare R2 or Backblaze B2.
BACKUP_SPACES_REGION=sgp1
BACKUP_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
BACKUP_SPACES_BUCKET=your-private-backup-space
BACKUP_SPACES_PREFIX=rajesh-shopping-center/backups
BACKUP_SPACES_ACCESS_KEY_ID=replace-with-storage-key
# SECRET in DigitalOcean.
BACKUP_SPACES_SECRET_ACCESS_KEY=replace-with-storage-secret

# ── WhatsApp (currently unused) ──────────────────────────────────────────────
# Read by utils/whatsapp-service.ts, which nothing calls — no WhatsApp message is
# ever sent. Kept only so the values are not lost. See docs/PRD-remaining-gaps.md
# section 8, which proposes deleting the modules.
# WHATSAPP_OWNER_NUMBER=
# WHATSAPP_API_KEY=
# WHATSAPP_PROVIDER=callmebot
