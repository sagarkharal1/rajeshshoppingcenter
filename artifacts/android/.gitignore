# Staged copy of the web build — regenerated by scripts/prepare-web.mjs.
www/

# Gradle build outputs and local machine state.
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/capacitor-cordova-android-plugins/

# Signing material. Losing the keystore means no future update can install
# over an existing one, so it is backed up out of band — never committed.
*.keystore
*.jks
keystore.properties

# Built APKs.
*.apk
*.aab
